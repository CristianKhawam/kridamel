# Copy to .env and fill in. Never commit .env.
PORT=3000
NODE_ENV=development
# From Atlas: Connect > Drivers. Put the database name (kridamel) after the last slash:
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/kridamel?retryWrites=true&w=majority
MONGODB_URI=
# Any long random text. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
APP_BASE_URL=http://localhost:3000
EMAIL_API_KEY=
EMAIL_FROM=
